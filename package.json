{
  "name": "fskintra-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server for ForældreIntra (SkoleIntra) — TypeScript, inspired by svalgaard/fskintra and Casperjuel/aula-mcp.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "fskintra": "bun apps/cli/src/index.ts",
    "mcp": "bun packages/mcp-server/src/server.ts",
    "mcp:stdio": "bun packages/mcp-server/src/server-stdio.ts",
    "status": "bun apps/cli/src/index.ts status",
    "doctor": "bun apps/cli/src/index.ts doctor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
