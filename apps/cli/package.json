{
  "name": "@fskintra-mcp/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line entry point for fskintra-mcp: login, status, doctor, logout.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fskintra": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build:bin": "bun build --compile --outfile bin/fskintra src/index.ts"
  },
  "dependencies": {
    "@fskintra-mcp/fskintra-auth": "workspace:*",
    "@fskintra-mcp/fskintra-client": "workspace:*",
    "@fskintra-mcp/mcp-server": "workspace:*"
  }
}
